<div class="er-events-list" data-collection-id="{collection.id}">

  <div class="er-events-table">
    {.repeated section upcoming}
    {.section sourceUrl}
    <a href="{sourceUrl}" target="_blank" class="er-event-row" id="event-{id}">
    {.or}
    <div class="er-event-row er-event-row--no-link" id="event-{id}">
    {.end}

      <div class="er-event-date">
        <span class="er-date-day">{startDate|date %d.%m.}</span>
        <span class="er-date-year">{startDate|date %Y}</span>
      </div>

      <div class="er-event-meta">
        <span class="er-event-title">{title}</span>
      </div>

      <div class="er-event-action">
        {.section sourceUrl}
        <span class="er-ticket-btn">Tickets &#8594;</span>
        {.or}
        <span class="er-ticket-btn er-ticket-btn--info">Info &#8594;</span>
        {.end}
      </div>

    {.section sourceUrl}
    </a>
    {.or}
    </div>
    {.end}
    {.end}
  </div>

</div>
